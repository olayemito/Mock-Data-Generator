# KoboToolbox
KOBO_API_TOKEN=your_kobo_api_token_here
KOBO_SERVER_URL=https://kf.kobotoolbox.org

# AI Providers (add the ones you use)
ANTHROPIC_API_KEY=your_anthropic_key_here
GROQ_API_KEY=your_groq_key_here

# OpenRouter (unified AI gateway)
OPENROUTER_API_KEY="your_openrouter_api_key_here"
DEFAULT_AI_MODEL="google/gemini-2.5-flash"
FALLBACK_AI_MODEL="meta-llama/llama-3.3-70b-instruct"

# App
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL="your_upstash_url_here"
UPSTASH_REDIS_REST_TOKEN="your_upstash_token_here"
